# Reggie credentials — copy this file to .env and fill in your details
REGGIE_EMAIL=you@example.com
REGGIE_PASSWORD=yourpassword

# ── Practice tally (optional) ──────────────────────────────────────────────
# Supabase Postgres connection string (Session pooler URI).
# Leave blank to disable the tally entirely — registration works either way.
TALLY_DB_URL=
# Long random string. Derives each swimmer's private key from their email,
# so it must stay secret and must not change once there is history.
# Generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
TALLY_SECRET=
